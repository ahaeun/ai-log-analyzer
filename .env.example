# docker compose up -d 실행 전, 이 파일을 복사해서 .env로 저장하고 실제 값을 채워넣으세요.
#   cp .env.example .env

# --- dashboard ---
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_TEAM_ID=
DASHBOARD_ALLOWED_EMAILS=you@example.com
DASHBOARD_SESSION_SECRET=change-me-to-a-random-string

# dashboard가 검증하는 값이자 analyzer가 dashboard 호출 시 보내는 값 (하나의 값을 양쪽에서 공유)
DASHBOARD_API_KEY=change-me-shared-with-analyzer

# --- analyzer ---
# ANALYZER_API_KEY는 watcher가 X-API-Key로 보내는 값과 동일해야 합니다.
ANALYZER_API_KEY=change-me-shared-with-watcher
OPENAI_API_KEY=
SLACK_WEBHOOK_URL=

# REDIS_URL, DASHBOARD_URL은 docker-compose 네트워크 안에서 서비스명으로
# 자동 연결되므로(docker-compose.yml에 이미 지정됨) 여기서는 설정하지 않습니다.
